# Data (managed by DVC, not Git)
# Ignore actual data files but allow DVC tracking files
data/**/*.csv
data/**/*.json
data/**/*.parquet
data/**/*.xlsx
data/**/*.zip
data/**/*.npy
!data/**/.gitignore
!data/**/*.dvc
!data/README.md
*.csv
*.parquet

# Models (managed by MLflow/DVC, not Git)
*.pkl
*.joblib
*.model
mlruns/

# Results directory is tracked for documentation and evaluation reporting
!results/**
results/**/*.pkl

# Environment
.env
.env.local
*.env

